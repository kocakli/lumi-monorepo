<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ system splash API. windowSplashScreenBackground is the
         solid cream paint behind the icon; windowSplashScreenAnimatedIcon
         reuses the adaptive-icon foreground (paper plane shape). The
         system handles the slide-out animation back to the activity. -->
    <style name="Theme.Lumi.Splash" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/lumi_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>

</resources>
